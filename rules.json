[
  {
    "id": 1,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "requestDomains": [
        "googleads.g.doubleclick.net",
        "pagead2.googlesyndication.com",
        "www.googleadservices.com",
        "ad.doubleclick.net",
        "static.doubleclick.net",
        "ade.googlesyndication.com",
        "tpc.googlesyndication.com",
        "cm.g.doubleclick.net",
        "stats.g.doubleclick.net",
        "adservice.google.com",
        "adservice.google.ru"
      ],
      "initiatorDomains": ["youtube.com"],
      "resourceTypes": [
        "image", "xmlhttprequest", "sub_frame", "ping",
        "script", "stylesheet", "media", "font", "object"
      ]
    }
  },
  {
    "id": 2,
    "priority": 2,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||youtube.com/pagead/*",
      "resourceTypes": ["xmlhttprequest", "sub_frame", "ping", "script"]
    }
  },
  {
    "id": 3,
    "priority": 2,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||youtube.com/api/stats/ads*",
      "resourceTypes": ["xmlhttprequest", "ping"]
    }
  },
  {
    "id": 4,
    "priority": 2,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||youtube.com/ptracking*",
      "resourceTypes": ["xmlhttprequest", "ping", "image"]
    }
  },
  {
    "id": 5,
    "priority": 2,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||youtube.com/youtubei/v1/log_event*",
      "resourceTypes": ["xmlhttprequest", "ping"]
    }
  }
]
